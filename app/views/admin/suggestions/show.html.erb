<%# One suggested fix: what Scorebook has, where we guess it belongs and why, the lines, and the decision. %>
<%
  content_for :title, "修正の提案 ##{@suggestion.id} - 管理画面 - Big6"
  content_for :head, tag.meta(name: "robots", content: "noindex, nofollow")
  filed = @suggestion.filed_under_game
  hits = @suggestion.hits_check
  roster = @suggestion.roster_check
  our_lines = @suggestion.our_lines_count
  # Where each line stands against our batting lines in the guessed game (FixSuggestion::LineState).
  states = @suggestion.line_states
  applied_ids = states.select { |state| state.state == :applied }.map { |state| state.line.player_id }
  to_apply_ids = states.select { |state| state.state == :to_apply }.map { |state| state.line.player_id }
  checks = @suggestion.team_checks(states)
  suggested_note = @suggestion.suggested_note(states, checks) if @suggestion.note.blank?
%>

<p><%= link_to "← 提案の一覧", admin_suggestions_path(status: @suggestion.status) %></p>
<h1><%= fix_suggestion_title(@suggestion) %></h1>
<p class="muted">
  <%= fix_suggestion_kind_label(@suggestion) %> ・ 確度：<%= fix_suggestion_confidence_label(@suggestion.confidence) %>
  ・ 状態：<%= fix_suggestion_status_label(@suggestion.status) %>
  <% if @suggestion.decided_at %>（<%= @suggestion.decided_at.in_time_zone("Asia/Tokyo").strftime("%Y-%m-%d %H:%M") %> <%= @suggestion.decided_by&.email %>）<% end %>
</p>
<% if @suggestion.status == "not_needed" %>
  <p class="flash">対応不要：この提案の行は、推測した試合の打撃成績として当サイトにすでに同じ値で入っています（Scorebook の試合ページから取り込み済み）。Scorebook の選手ページだけが別の試合に登録している状態で、当サイトで直すものはありません。確認のうえ、却下して構いません。</p>
<% end %>
<% if @suggestion.stray? %>
  <p class="flash flash-alert">別の試合の成績の紛れ込み：この提案の行の選手は全員、Scorebook の選手ページに、同じ日の正しい試合（<%= @suggestion.lines.map(&:twin_scorebook_game_id).uniq.join("、") %>）にも登録された行を持っています。この行は推測した試合の抜けた成績ではなく、別の試合の成績表が紛れ込んだものと考えられるため、反映の対象にしていません。確認のうえ、却下して構いません。</p>
<% end %>

<h2 class="card-heading">試合</h2>
<dl class="admin-facts">
  <dt>Scorebook の登録先</dt>
  <dd>
    <%= fix_suggestion_game_link(filed) %>
    （<%= link_to "Scorebook #{@suggestion.scorebook_game_id}", scorebook_game_page_url(@suggestion.scorebook_game_id), target: "_blank", rel: "noopener" %>）
  </dd>
  <% if @suggestion.kind == "misfiled_lines" %>
    <dt>推測した試合</dt>
    <dd>
      <% if @suggestion.game %>
        <%= fix_suggestion_game_link(@suggestion.game) %>
        <% if @suggestion.game.scorebook_game_id %>
          （<%= link_to "Scorebook #{@suggestion.game.scorebook_game_id}", scorebook_game_page_url(@suggestion.game.scorebook_game_id), target: "_blank", rel: "noopener" %>）
        <% end %>
      <% else %>
        候補が1つに絞れません
      <% end %>
    </dd>
    <% if @suggestion.candidate_game_ids.size > 1 %>
      <dt>候補（同じ日の<%= @suggestion.university&.short_name %>の試合）</dt>
      <dd>
        <% @suggestion.candidate_games.each do |game| %>
          <%= fix_suggestion_game_link(game) %><br>
        <% end %>
      </dd>
    <% end %>
  <% end %>
</dl>

<% if @suggestion.kind == "misfiled_lines" && @suggestion.game %>
  <h2 class="card-heading">根拠</h2>
  <ul class="list">
    <li>同じ日の<%= @suggestion.university&.short_name %>の試合：<%= @suggestion.candidate_game_ids.size %>試合</li>
    <li>当サイトにある<%= @suggestion.university&.short_name %>の打撃成績（推測した試合）：<%= our_lines %>人分<%= "（空なので矛盾しません）" if our_lines&.zero? %></li>
    <li>安打の合計（集まった行 / スコアボードの H）：<%= fix_suggestion_hits_label(hits) %></li>
    <li>ベンチ入りメンバーとの照合：<%= roster ? "#{roster[:on_roster]} / #{roster[:lines]} 人が名簿にいる（名簿 #{roster[:roster]} 人）" : "名簿なし（2021年より前の試合か、名簿が未取り込み）" %></li>
    <% if checks.any? %>
      <li>
        チームの合計（当サイトの<%= @suggestion.university&.short_name %>打者 / 相手投手）：
        <% checks.each do |check| %>
          <br><%= check.matches? ? "✓" : "✗" %> <%= check.batting_label %> <%= check.batting %> / <%= check.pitching_label %> <%= check.pitching %>
          <% if check.batting_with_scorebook %>（Scorebook 選手ページの値にすると <%= check.batting_with_scorebook %><%= check.scorebook_matches? ? " ✓" : " ✗" %>）<% end %>
        <% end %>
      </li>
    <% else %>
      <li>チームの合計：相手投手の成績が当サイトにないため照合できません</li>
    <% end %>
  </ul>
  <p class="muted">行は、夜間の照合でチームメイトの選手ページを読むたびに増えます。安打の合計がスコアボードの H と一致すれば、チーム全員分がそろっています。</p>
<% elsif @suggestion.kind == "same_team_game" %>
  <p class="muted">Scorebook の試合情報で両チームが同じ大学になっています。試合情報そのものの誤りなので、対戦相手を日程から確かめる必要があります。</p>
<% end %>

<h2 class="card-heading">行（<%= @lines.size %>人）</h2>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>選手</th>
        <th>守備</th>
        <% Admin::SuggestionsHelper::LINE_COLUMNS.each_value do |label| %>
          <th><%= label %></th>
        <% end %>
        <th>Scorebook</th>
        <th>反映</th>
      </tr>
    </thead>
    <tbody>
      <% states.each do |state| %>
        <% line = state.line %>
        <tr>
          <td><%= link_to line.player.name, player_path(line.player) %></td>
          <td><%= line.position %></td>
          <% Admin::SuggestionsHelper::LINE_COLUMNS.each_key do |field| %>
            <td><%= line.value(field) || "-" %></td>
          <% end %>
          <td><%= link_to "選手ページ", scorebook_member_page_url(line.player), target: "_blank", rel: "noopener" %></td>
          <td><%= fix_suggestion_line_state_label(state) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @suggestion.applicable? || @suggestion.applied? %>
  <h2 class="card-heading">成績への反映</h2>
  <% if @suggestion.applied_at %>
    <p class="muted"><%= @suggestion.applied_at.in_time_zone("Asia/Tokyo").strftime("%Y-%m-%d %H:%M") %> に <%= @suggestion.applied_by&.email %> が反映（当サイトの打撃成績 <%= applied_ids.size %>人分）。</p>
  <% end %>
  <p class="muted">推測した試合の<%= @suggestion.university&.short_name %>の打撃成績として加えます。その試合にすでに打撃成績がある選手（Scorebook から取り込み済み）は加えません。反映した行は Scorebook からの取り込み直しでも消えず、Scorebook の試合ページにその選手の成績が載ったときは、そちらに置き換わります。</p>
  <% if (published = @suggestion.announcement) %>
    <p class="muted">掲載中のおしらせ（<%= published.published_at.in_time_zone("Asia/Tokyo").strftime("%Y-%m-%d %H:%M") %> 掲載<%= "、#{published.updated_at.in_time_zone("Asia/Tokyo").strftime("%Y-%m-%d %H:%M")} 更新" if published.revised? %>）：</p>
    <blockquote class="admin-notice">
      <strong><%= link_to published.title, news_item_path(published) %></strong>
      <p><%= linked_text(published.body) %></p>
    </blockquote>
  <% end %>

  <% if @suggestion.applicable? && to_apply_ids.any? %>
    <% default_title, default_body = @suggestion.default_announcement %>
    <%= form_with url: apply_admin_suggestion_path(@suggestion), method: :post, class: "admin-decision",
          data: { turbo_confirm: "#{to_apply_ids.size}人分の打撃成績を当サイトに加え、おしらせを#{@suggestion.announcement ? "更新" : "掲載"}します。よろしいですか？" } do |form| %>
      <p class="muted">おしらせ（反映と同時に<%= @suggestion.announcement ? "更新" : "掲載" %>します。人数は、反映後の合計で入れてあります）：</p>
      <%= form.label :announcement_title, "タイトル" %>
      <%= form.text_field :announcement_title, value: default_title %>
      <%= form.label :announcement_body, "本文" %>
      <%= form.text_area :announcement_body, value: default_body, rows: 10 %>
      <div class="period-toolbar">
        <%= form.button "成績に反映（#{to_apply_ids.size}人分）", class: "period-btn" %>
      </div>
    <% end %>
  <% end %>

  <% if @suggestion.applicable? && to_apply_ids.empty? %>
    <p class="muted">加える行はありません。この提案の行の選手は全員、推測した試合の打撃成績が当サイトにすでにあります（上の表の「反映」列）。</p>
  <% end %>

  <% if @suggestion.applied? %>
    <div class="period-toolbar">
      <%= button_to "反映を取り消す", unapply_admin_suggestion_path(@suggestion), class: "period-btn", form: { data: { turbo_confirm: "反映した打撃成績と、そのおしらせを削除します。よろしいですか？" } } %>
    </div>
  <% end %>
<% end %>

<h2 class="card-heading">決定</h2>
<p class="muted">承認しただけでは成績は変わりません（上の「成績に反映」で加わります）。却下しても、あとから未決定に戻せます。夜間ジョブが同じ提案を新しく作り直すことはありません。</p>
<% if @suggestion.applied? %>
  <p class="muted">成績に反映済みなので、決定を変えるには先に反映を取り消してください。</p>
<% end %>
<%= form_with url: admin_suggestion_path(@suggestion), method: :patch, class: "admin-decision" do |form| %>
  <%= form.label :note, "メモ" %>
  <% if suggested_note %>
    <p class="muted">メモ欄には、照合の結果から作った案を入れてあります。直してから決定できます。</p>
  <% end %>
  <%= form.text_area :note, value: @suggestion.note.presence || suggested_note, rows: 4 %>
  <div class="period-toolbar">
    <% if FixSuggestion::UNDECIDED.include?(@suggestion.status) %>
      <%= form.button "承認", name: "decision", value: "approved", class: "period-btn" %>
      <%= form.button "却下", name: "decision", value: "discarded", class: "period-btn" %>
    <% elsif !@suggestion.applied? %>
      <%= form.button "未決定に戻す", name: "decision", value: "pending", class: "period-btn" %>
    <% end %>
  </div>
<% end %>
