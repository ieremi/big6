<%# The open-all and close-all buttons of a decade-fold section on a game page (the bench, the box score).
    Their shortcuts are data-shortcut-all, so u and f open or close every section on the page at once, not just the first. %>
<div class="period-toolbar">
  <button type="button" class="period-btn" data-action="decade-fold#openAll" data-shortcut="u" data-shortcut-all="true" data-shortcut-label="すべて開く">すべて開く <kbd>u</kbd></button>
  <button type="button" class="period-btn" data-action="decade-fold#closeAll" data-shortcut="f" data-shortcut-all="true" data-shortcut-label="すべて閉じる">すべて閉じる <kbd>f</kbd></button>
</div>
