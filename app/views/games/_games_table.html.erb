<table>
  <thead>
    <tr>
      <% if local_assigns[:show_season] %>
        <th>シーズン</th>
      <% end %>
      <th>日付</th>
      <th>回戦</th>
      <th>対戦</th>
    </tr>
  </thead>

  <tbody>
    <% games.each do |game| %>
      <% row_data = if local_assigns[:game_periods]
           { period_filter_target: "gameRow", periods: local_assigns[:game_periods][game.id]&.join(" ") }
         else
           {}
         end %>
      <%= tag.tr data: row_data do %>
        <% if local_assigns[:show_season] %>
          <td><%= game.season.title %></td>
        <% end %>
        <td><%= game.played_on %></td>
        <td><%= game.game_number %>回戦</td>
        <td>
          <%= link_to game_path(game) do %>
            <%= game.team0.short_name %>
            <%= score_span(game.team0_score, game.team1_score) %>
            <%= game.team1.short_name %>
          <% end %>
        </td>
      <% end %>
    <% end %>
  </tbody>
</table>
