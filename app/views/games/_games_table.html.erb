<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <% if local_assigns[:show_season] %>
          <%= sortable_game_header("season", "シーズン", "S") %>
        <% end %>
        <%= sortable_game_header("date", "日付", "D") %>
        <%= sortable_game_header("round", "回戦", "N") %>
        <%= sortable_game_header("card", "カード", "C") %>
        <%= sortable_game_header("attendance", "観衆", "A", first: "desc") %>
      </tr>
    </thead>

    <tbody>
      <% games.each do |game| %>
        <% row_data = if local_assigns[:game_periods]
             { period_filter_target: "gameRow", periods: local_assigns[:game_periods][game.id]&.join(" "), status: game.game_status }
           else
             {}
           end %>
        <%= tag.tr data: row_data do %>
          <% if local_assigns[:show_season] %>
            <td><%= link_to game.season.title, season_path(game.season.year, game.season.term) %></td>
          <% end %>
          <td><%= game.played_on %></td>
          <td><%= round_label(game) %></td>
          <td><%= game_matchup_link(game) %></td>
          <td><%= game.attendance.present? ? number_with_delimiter(game.attendance) : "-" %></td>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
