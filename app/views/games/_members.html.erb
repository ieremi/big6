<%# Each team's roster for the game (bench included), from Scorebook, in a collapsible section (closed until opened). Only games from 2021 on have one.
    While a game is in progress, Scorebook has no GameMember list of its own yet — members_by_university is passed
    empty, and official_lineup (LeagueOfficialLineup, present? only while there's something to show) provides a
    provisional stand-in scraped from the league site's box score instead. %>
<% provisional = members_by_university.blank? && local_assigns[:official_lineup]&.present? %>
<% source = provisional ? official_lineup.by_university : members_by_university %>
<% rosters = [ game.team0, game.team1 ].filter_map do |team|
     members = GameMember.roster_order(source.fetch(team.id, []))
     [ team, members ] if members.any?
   end %>

<% if rosters.any? %>
  <h2 class="card-heading">ベンチ入りメンバー</h2>
  <% if provisional %>
    <p class="muted">暫定データ（東京六大学野球連盟公式サイトより。Scorebookの確定データ待ち。出場した選手のみ）</p>
  <% end %>

  <div data-controller="decade-fold">
    <div class="period-toolbar">
      <button type="button" class="period-btn" data-action="decade-fold#openAll" data-shortcut="u" data-shortcut-label="すべて開く">すべて開く <kbd>u</kbd></button>
      <button type="button" class="period-btn" data-action="decade-fold#closeAll" data-shortcut="f" data-shortcut-label="すべて閉じる">すべて閉じる <kbd>f</kbd></button>
    </div>

    <% rosters.each do |team, members| %>
      <%= tag.details class: "decade", data: { decade_fold_target: "decade" } do %>
        <summary>
          <span class="team-chip" style="background: <%= team.color %>"><%= team.initial %></span>
          <%= team.short_name %>（<%= members.size %>人）
        </summary>

        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>背番号</th>
                <th>氏名</th>
                <th>学年</th>
                <th>役割</th>
                <th>打順</th>
                <th>守備</th>
              </tr>
            </thead>
            <tbody>
              <% members.each do |member| %>
                <tr>
                  <td><%= member.uniform_number %></td>
                  <td><%= link_to member.player.name, player_path(member.player) %></td>
                  <td><%= member.grade %></td>
                  <td><%= member.role %></td>
                  <td><%= member.batting_order %></td>
                  <td><%= member.fielding_position %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
