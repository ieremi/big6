<%
  period_label = @season ? @season.title : (@year ? "#{@year}年" : nil)
  content_for :title, "#{@team0.short_name}#{period_label ? " #{period_label}" : ""} - Big6"
  content_for :description, "#{@team0.short_name}#{period_label}の試合一覧"
  content_for :image_url, @season ? team_season_og_image_url(@team0.slug, @season.year, @season.term) : team_og_image_url(@team0.slug)
%>

<h1>
  <%= @team0.short_name %>
  <%= period_label %>
</h1>

<p class="muted"><%= games_count_label(@games) %></p>

<% @games_by_opponent.each do |opponent, games| %>
  <h2>
    <span class="team-chip" style="background: <%= opponent.color %>"><%= opponent.initial %></span>
    vs <%= opponent.short_name %>
  </h2>
  <%= render "games_table", games: games %>
<% end %>
