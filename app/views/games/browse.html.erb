<h1>
  <%= @team0.short_name %>
  <%= "vs #{@team1.short_name}" if @team1 %>
  <%= @season ? @season.title : (@year ? "#{@year}年" : nil) %>
</h1>

<p class="muted"><%= @games.size %>試合</p>

<table>
  <thead>
    <tr>
      <th>日付</th>
      <th>回戦</th>
      <th>対戦</th>
    </tr>
  </thead>

  <tbody>
    <% @games.each do |game| %>
      <tr>
        <td><%= game.played_on %></td>
        <td><%= game.game_number %>回戦</td>
        <td>
          <%= link_to game_path(game) do %>
            <%= game.team0.short_name %>
            <%= score_span(game.team0_score, game.team1_score) %>
            <%= game.team1.short_name %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
