<h1>試合</h1>

<p class="muted">大学を選んでください。</p>

<ul class="list">
  <% @universities.each do |u| %>
    <li>
      <%= link_to team_browse_path(u.slug) do %>
        <span class="team-chip" style="background: <%= u.color %>"><%= u.initial %></span>
        <%= u.name %>
        <span class="muted">(<%= @games_counts[u.id] %>試合)</span>
      <% end %>
    </li>
  <% end %>
</ul>
