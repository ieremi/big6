<%
  in_progress = @game.team0_score.nil? || @game.team1_score.nil?
  is_future = @game.played_on >= Date.current
  detail = @scoreboard.innings.any? ? @scoreboard : @official_scoreboard
  provisional = detail.innings.any? && !@scoreboard.innings.any?
  game_score = "#{@game.team0.short_name} #{in_progress ? "vs" : "#{@game.team0_score}-#{@game.team1_score}"} #{@game.team1.short_name}"
  content_for :title, "#{game_score}（#{@game.season.title}第#{@game.game_number}回戦） - Big6"
  content_for :description, [
    @game.played_on.to_s,
    game_score,
    (detail.attendance.present? ? "観衆#{detail.attendance.to_s.strip}人" : nil)
  ].compact.join(" ")
  content_for :image_url, game_og_image_url(@game.team0.slug, @game.team1.slug, @game.season.year, @game.season.term, @game.game_number)
%>

<h1>
  <%= link_to @game.season.title, season_path(@game.season.year, @game.season.term) %>
  <%= link_to "#{@game.team0.short_name} vs #{@game.team1.short_name}", matchup_season_path(@game.team0.slug, @game.team1.slug, @game.season.year, @game.season.term) %>
</h1>

<p class="muted">
  <%= @game.played_on %>　<%= @game.game_number %>回戦
  <% if detail.stadium.present? %>　<%= detail.stadium %><% end %>
  <% if detail.attendance.present? %>　観衆<%= detail.attendance %>人<% end %>
  <% if @game.weather_summary.present? %>　<%= @game.weather_summary %><% end %>
  <% if @game.temp_high.present? %>　最高<%= @game.temp_high %>℃<% end %>
  <% if @game.temp_low.present? %>　最低<%= @game.temp_low %>℃<% end %>
  　<span class="season-tag game-status" data-status="<%= @game.game_status %>"><%= @game.status_label %></span>
</p>

<% if detail.innings.any? %>
  <% if provisional %>
    <p class="muted">暫定データ（東京六大学野球連盟公式サイトより。Scorebookの確定データ待ち）</p>
  <% end %>
  <div class="table-zoom" data-controller="table-zoom" data-action="keydown.esc@window->table-zoom#closeOnEscape">
    <div class="table-zoom-backdrop" data-table-zoom-target="backdrop" data-action="click->table-zoom#close"></div>

    <div class="scoreboard" data-table-zoom-target="panel">
      <div class="table-zoom-bar">
        <button type="button" class="table-zoom-btn" data-table-zoom-target="button" data-action="table-zoom#toggle">⤢ 拡大表示</button>
      </div>

      <table class="scoreboard-table">
        <thead>
          <tr>
            <th class="team-col"></th>
            <% detail.innings.each do |n| %>
              <th><%= n %></th>
            <% end %>
            <th>計</th>
            <th>安</th>
            <th>失</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td class="team-col">
              <span class="team-chip" style="background: <%= @game.team0.color %>"><%= @game.team0.initial %></span>
              <%= @game.team0.short_name %>
            </td>
            <% detail.innings.each do |n| %>
              <td><%= detail.top_runs(n) %></td>
            <% end %>
            <td class="total"><%= @game.team0_score.nil? ? "-" : @game.team0_score %></td>
            <td><%= detail.top_hits %></td>
            <td><%= detail.top_errors %></td>
          </tr>
          <tr>
            <td class="team-col">
              <span class="team-chip" style="background: <%= @game.team1.color %>"><%= @game.team1.initial %></span>
              <%= @game.team1.short_name %>
            </td>
            <% detail.innings.each do |n| %>
              <td><%= detail.bottom_runs(n) %></td>
            <% end %>
            <td class="total"><%= @game.team1_score.nil? ? "-" : @game.team1_score %></td>
            <td><%= detail.bottom_hits %></td>
            <td><%= detail.bottom_errors %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <dl class="scoreboard-meta">
    <% if detail.started_at.present? %>
      <div>
        <dt>試合時間</dt>
        <dd><%= clock_time_12h(detail.started_at) %> 〜 <%= clock_time_12h(detail.finished_at) %>（<%= detail.duration %>）</dd>
      </div>
    <% end %>
    <% if detail.umpires.any? %>
      <div>
        <dt>審判</dt>
        <dd><%= detail.umpires.join("、") %></dd>
      </div>
    <% end %>
  </dl>
<% else %>
  <p>
    <%= @game.team0.short_name %>
    <%= score_span(@game.team0_score, @game.team1_score, played_on: @game.played_on, status: @game.status_label) %>
    <%= @game.team1.short_name %>
  </p>
  <p class="muted">
    <% if @game.scheduled? %>
      この試合はまだ行われていません。
    <% elsif @game.in_progress? %>
      試合中です。詳細データはまだありません。
    <% else %>
      詳細データはありません。
    <% end %>
  </p>

  <% if @game.scheduled? && is_future
       estimate = EstimatedGameSchedule.new(@game)
       start_time = estimate.scheduled_start_time
       end_time = estimate.estimated_end_time
     %>
    <% if start_time %>
      <p class="muted">
        予想試合時間：<%= clock_time_12h(start_time) %> 〜 <%= clock_time_12h(end_time) %>（開始・所要時間はあくまで目安です）
      </p>
    <% end %>
  <% end %>
<% end %>

<%= render "games/members", game: @game, members_by_university: @game_members_by_university %>

<% if (url = league_official_game_url(@game)) %>
  <p class="muted">
    <%= link_to "東京六大学野球連盟のページで見る →", url, target: "_blank", rel: "noopener noreferrer" %>
  </p>
<% end %>
<% if (url = scorebook_game_url(@game)) %>
  <p class="muted">
    <%= link_to "Scorebookで見る →", url, target: "_blank", rel: "noopener noreferrer" %>
  </p>
<% end %>
<% youtube_url = @scoreboard.youtube_url %>
<% if @game.video_url.blank? && youtube_url.blank? %>
  <p class="muted">動画はありません。</p>
<% end %>
<% if @game.video_url.present? %>
  <p class="muted">
    <%= link_to "BIG6.TVで見る →", @game.video_url, target: "_blank", rel: "noopener noreferrer" %>
  </p>
<% end %>
<% if youtube_url.present? %>
  <p class="muted">
    <%= link_to "YouTubeで見る →", youtube_url, target: "_blank", rel: "noopener noreferrer" %>
  </p>
<% end %>
<p class="muted">
  <%= link_to "カレンダーに追加 (.ics)", game_ics_path(@game) %>
  ・
  <%= link_to "Googleカレンダーに登録", google_calendar_subscribe_url(game_ics_url(@game)), target: "_blank", rel: "noopener noreferrer" %>
</p>
<%= render "shared/ics_preview", url: game_ics_path(@game) %>
