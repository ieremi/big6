<%
  content_for :title, "Big6 - 東京六大学野球データベース（試合結果・順位表・選手成績）"
  content_for :description, "東京六大学野球（1925年〜）の全試合の結果、シーズンの順位表、大学どうしの対戦成績、選手の成績とランキング。BIG6 Scorebook と連盟公式サイトをもとにしたデータベース。"
  content_for :image_url, site_og_image_url
  content_for :head, structured_data(website_structured_data)
%>

<h1>Big6</h1>
<p class="muted">東京六大学野球の記録データベース。左上のメニュー（<kbd>-</kbd>キー）、または下のリンクから見たいページへ。</p>

<nav class="home-links">
  <% if (season = latest_season) %>
    <%= link_to season_path(season.year, season.term), class: "home-link" do %>最新シーズン <kbd>1</kbd><% end %>
  <% end %>
  <%= link_to seasons_path, class: "home-link" do %>すべてのシーズン <kbd>2</kbd><% end %>
  <%= link_to matchups_path, class: "home-link" do %>対戦カード <kbd>3</kbd><% end %>
  <%= link_to games_path, class: "home-link" do %>試合 <kbd>4</kbd><% end %>
  <%= link_to universities_path, class: "home-link" do %>大学 <kbd>5</kbd><% end %>
  <%= link_to players_path, class: "home-link" do %>選手 <kbd>6</kbd><% end %>
  <%= link_to rankings_path, class: "home-link" do %>ランキング <kbd>7</kbd><% end %>
  <%= link_to api_docs_path, class: "home-link" do %>Web API <kbd>8</kbd><% end %>
</nav>

<% if @announcements.any? %>
  <h2 class="card-heading">おしらせ</h2>
  <%= render "news/list", announcements: @announcements %>
  <p><%= link_to "すべてのおしらせ →", news_path %></p>
<% end %>
