<%
  attendance_games = games.select { |g| g.attendance.present? }
%>
<% if attendance_games.any? %>
  <% max_attendance = attendance_games.map(&:attendance).max %>
  <p class="muted">観衆数の推移</p>
  <div class="attendance-chart">
    <% attendance_games.each do |game| %>
      <% height_pct = max_attendance.positive? ? (game.attendance.to_f / max_attendance * 100).round(1) : 0 %>
      <%= tag.div class: "attendance-bar-wrap",
            tabindex: "0",
            title: "#{game.season.title} #{game.played_on} 観衆#{number_with_delimiter(game.attendance)}人",
            data: (local_assigns[:game_periods] ? { period_filter_target: "periodItem", periods: local_assigns[:game_periods][game.id]&.join(" ") } : {}) do %>
        <div class="attendance-bar" style="height: <%= height_pct %>%;"></div>
        <span class="attendance-tooltip">
          <%= game.season.title %> <%= game.played_on %><br>
          <%= number_with_delimiter(game.attendance) %>人
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
