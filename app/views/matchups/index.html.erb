<h1>対戦成績</h1>

<% pct = ->(value) { value.nil? ? "—" : number_with_precision(value, precision: 3).sub(/\A0/, "") } %>
<% num = ->(value) { value.nil? ? "—" : number_with_delimiter(value) } %>

<div data-controller="period-filter">
  <div class="period-toolbar">
    <span class="muted">表示指標:</span>
    <button type="button" class="period-btn" data-metric="rate" data-period-filter-target="metricButton" data-action="period-filter#setMetric">勝率 <kbd>w</kbd></button>
    <button type="button" class="period-btn" data-metric="attendance" data-period-filter-target="metricButton" data-action="period-filter#setMetric">観衆 <kbd>p</kbd></button>
  </div>

  <div class="period-toolbar">
    <span class="muted">表示期間:</span>
    <button type="button" class="period-btn" data-period="all" data-period-filter-target="button" data-action="period-filter#setPeriod">すべて <kbd>a</kbd></button>
    <button type="button" class="period-btn" data-period="20" data-period-filter-target="button" data-action="period-filter#setPeriod">20年 <kbd>l</kbd></button>
    <button type="button" class="period-btn" data-period="10" data-period-filter-target="button" data-action="period-filter#setPeriod">10年 <kbd>m</kbd></button>
    <button type="button" class="period-btn" data-period="5" data-period-filter-target="button" data-action="period-filter#setPeriod">5年 <kbd>s</kbd></button>
    <button type="button" class="period-btn" data-period="r" data-period-filter-target="button" data-action="period-filter#setPeriod">直近シーズン <kbd>r</kbd></button>
    <span class="muted">切替 <kbd>&lt;</kbd><kbd>&gt;</kbd></span>
  </div>

  <p class="muted">
    列見出しをクリック（または <kbd>W</kbd><kbd>K</kbd><kbd>M</kbd><kbd>H</kbd><kbd>T</kbd><kbd>R</kbd><kbd>A</kbd><kbd>S</kbd>）すると、その列の値で並べ替えられます。
    観衆表示では各セルに平均（計は合計）を表示します。
  </p>

  <div class="table-scroll">
    <table class="standings-table">
      <thead>
        <tr>
          <th class="col-team"></th>
          <% @universities.each_with_index do |u, index| %>
            <th class="sortable"
                data-action="click->period-filter#sortByColumn"
                data-cell-index="<%= index + 1 %>"
                data-sort-kind="avg"
                data-shortcut="<%= u.initial %>"
                data-shortcut-label="<%= u.short_name %>で並べ替え">
              <span class="team-chip" style="background: <%= u.color %>"><%= u.initial %></span>
              <kbd><%= u.initial %></kbd>
            </th>
          <% end %>
          <th class="sortable"
              data-action="click->period-filter#sortByColumn"
              data-cell-index="<%= @universities.size + 1 %>"
              data-sort-kind="avg"
              data-shortcut="A"
              data-shortcut-label="平均で並べ替え">平均 <kbd>A</kbd></th>
          <th class="sortable"
              data-action="click->period-filter#sortByColumn"
              data-cell-index="<%= @universities.size + 2 %>"
              data-sort-kind="sum"
              data-shortcut="S"
              data-shortcut-label="合計で並べ替え">合計 <kbd>S</kbd></th>
        </tr>
      </thead>

      <tbody>
        <% @universities.each do |row_university| %>
          <tr>
            <td class="col-team">
              <span class="team-chip" style="background: <%= row_university.color %>"><%= row_university.initial %></span>
            </td>
            <% @universities.each do |col_university| %>
              <td class="result-cell">
                <% if row_university == col_university %>
                  <span class="dash">---</span>
                <% else %>
                  <% cell = @cells[[ row_university.id, col_university.id ]] %>
                  <% rates = cell["rate"].transform_values { |v| pct.call(v) } %>
                  <% avgs = cell["attendance_avg"].transform_values { |v| num.call(v) } %>
                  <% sums = cell["attendance_sum"].transform_values { |v| num.call(v) } %>
                  <% data = { period_filter_target: "cell" } %>
                  <% @periods.each_key do |k|
                       data["rate_#{k}".to_sym] = rates[k]
                       data["attendance_avg_#{k}".to_sym] = avgs[k]
                       data["attendance_sum_#{k}".to_sym] = sums[k]
                     end %>
                  <%= link_to rates["all"],
                        matchup_path(team0_slug: row_university.slug, team1_slug: col_university.slug),
                        data: data %>
                <% end %>
              </td>
            <% end %>
            <% row_rate_avg = @row_avg[row_university.id]["rate"].transform_values { |v| pct.call(v) } %>
            <% row_attendance_avg = @row_avg[row_university.id]["attendance"].transform_values { |v| num.call(v) } %>
            <% row_attendance_sum = @row_sum[row_university.id]["attendance"].transform_values { |v| num.call(v) } %>
            <% avg_data = { period_filter_target: "rowAvg" } %>
            <% sum_data = { period_filter_target: "rowSum" } %>
            <% @periods.each_key do |k|
                 avg_data["rate_#{k}".to_sym] = row_rate_avg[k]
                 avg_data["attendance_#{k}".to_sym] = row_attendance_avg[k]
                 sum_data["attendance_#{k}".to_sym] = row_attendance_sum[k]
               end %>
            <td class="result-cell avg-cell">
              <%= content_tag :span, row_rate_avg["all"], data: avg_data %>
            </td>
            <td class="result-cell sum-cell">
              <%= content_tag :span, "—", data: sum_data %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
