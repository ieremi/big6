<td><%= totals.games %></td>
<td><%= totals.started %></td>
<td><%= totals.complete_game %></td>
<td><%= totals.shutout %></td>
<td><%= totals.wins %></td>
<td><%= totals.losses %></td>
<td><%= innings_label(totals.outs) %></td>
<td><%= totals.hits %></td>
<td><%= totals.home_runs %></td>
<td><%= totals.strikeouts %></td>
<td><%= totals.walks %></td>
<td><%= totals.runs %></td>
<td><%= totals.earned_runs %></td>
