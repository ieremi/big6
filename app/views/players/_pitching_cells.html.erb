<%# The stat cells of a pitching row for a PitchingLine::Totals, in the column order of the stats tables. %>
<%= sort_cell era_label(totals.era), totals.era %>
<td><%= totals.games %></td>
<td><%= totals.started %></td>
<td><%= totals.complete_game %></td>
<td><%= totals.shutout %></td>
<td><%= totals.wins %></td>
<td><%= totals.losses %></td>
<%= sort_cell innings_label(totals.outs), totals.outs %>
<td><%= totals.hits %></td>
<td><%= totals.home_runs %></td>
<td><%= totals.strikeouts %></td>
<td><%= totals.walks %></td>
<td><%= totals.runs %></td>
<td><%= totals.earned_runs %></td>
