<%# Season and career stats from the player's per-game lines, then the per-game lines in collapsible sections. %>
<% if stats.batting? %>
  <h2 class="card-heading">打撃成績</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>シーズン</th><th>打率</th><th title="出塁率＋長打率">OPS</th><th>試合</th><th>打席</th><th>打数</th><th>安打</th><th>二塁打</th><th>三塁打</th><th>本塁打</th>
          <th>打点</th><th>得点</th><th>三振</th><th>四死球</th><th>犠打・犠飛</th><th>盗塁</th><th>併殺打</th><th>失策</th>
        </tr>
      </thead>
      <tbody>
        <% stats.batting_seasons.each do |row| %>
          <tr>
            <td><%= link_to row.season.title, season_path(row.season.year, row.season.term) %></td>
            <%= render "players/batting_cells", totals: row.totals %>
          </tr>
        <% end %>
        <tr class="stats-total">
          <td>通算</td>
          <%= render "players/batting_cells", totals: stats.batting_total %>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="muted">OPS ＝ 出塁率 ＋ 長打率。出塁率は（安打＋四死球）÷（打数＋四死球）で計算しています。犠飛だけの記録がないため、犠飛は含めていません。</p>
<% end %>

<% if stats.pitching? %>
  <h2 class="card-heading">投手成績</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>シーズン</th><th>防御率</th><th>登板</th><th>先発</th><th>完投</th><th>完封</th><th>勝</th><th>敗</th>
          <th>投球回</th><th>被安打</th><th>被本塁打</th><th>奪三振</th><th>与四死球</th><th>失点</th><th>自責点</th>
        </tr>
      </thead>
      <tbody>
        <% stats.pitching_seasons.each do |row| %>
          <tr>
            <td><%= link_to row.season.title, season_path(row.season.year, row.season.term) %></td>
            <%= render "players/pitching_cells", totals: row.totals %>
          </tr>
        <% end %>
        <tr class="stats-total">
          <td>通算</td>
          <%= render "players/pitching_cells", totals: stats.pitching_total %>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<% if stats.batting? || stats.pitching? %>
  <p class="muted">優勝決定戦は、Scorebookに合わせて、シーズン成績と通算に含めていません。</p>

  <div data-controller="decade-fold">
    <div class="period-toolbar">
      <button type="button" class="period-btn" data-action="decade-fold#openAll" data-shortcut="u" data-shortcut-label="すべて開く">すべて開く <kbd>u</kbd></button>
      <button type="button" class="period-btn" data-action="decade-fold#closeAll" data-shortcut="f" data-shortcut-label="すべて閉じる">すべて閉じる <kbd>f</kbd></button>
    </div>

    <% if stats.batting? %>
      <%= tag.details class: "decade", data: { decade_fold_target: "decade" } do %>
        <summary>打撃 試合別成績（<%= stats.batting_lines.size %>試合）</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>日付</th><th>相手</th><th>打席</th><th>打数</th><th>安打</th><th>二塁打</th><th>三塁打</th><th>本塁打</th>
                <th>打点</th><th>得点</th><th>三振</th><th>四死球</th><th>犠打・犠飛</th><th>盗塁</th><th>併殺打</th><th>失策</th>
              </tr>
            </thead>
            <tbody>
              <% stats.batting_lines.each do |line| %>
                <tr>
                  <td><%= line.game.played_on %></td>
                  <td>
                    <%= link_to "#{opponent_name(line)}（#{line.game.game_number}回戦）", player_game_path(line.game) %>
                    <% unless line.game.counted_in_stats %><span class="season-tag">通算に含まず</span><% end %>
                  </td>
                  <td><%= line.pa %></td><td><%= line.ab %></td><td><%= line.hits %></td><td><%= line.doubles %></td><td><%= line.triples %></td><td><%= line.home_runs %></td>
                  <td><%= line.rbi %></td><td><%= line.runs %></td><td><%= line.strikeouts %></td><td><%= line.walks %></td><td><%= line.sacrifices %></td>
                  <td><%= line.stolen_bases %></td><td><%= line.gidp %></td><td><%= line.fielding_errors %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>

    <% if stats.pitching? %>
      <%= tag.details class: "decade", data: { decade_fold_target: "decade" } do %>
        <summary>投手 試合別成績（<%= stats.pitching_lines.size %>試合）</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>日付</th><th>相手</th><th>結果</th><th>投球回</th><th>打者</th><th>球数</th><th>被安打</th><th>被本塁打</th>
                <th>奪三振</th><th>与四死球</th><th>失点</th><th>自責点</th>
              </tr>
            </thead>
            <tbody>
              <% stats.pitching_lines.each do |line| %>
                <tr>
                  <td><%= line.game.played_on %></td>
                  <td>
                    <%= link_to "#{opponent_name(line)}（#{line.game.game_number}回戦）", player_game_path(line.game) %>
                    <% unless line.game.counted_in_stats %><span class="season-tag">通算に含まず</span><% end %>
                  </td>
                  <td><%= line.wins.positive? ? "勝" : (line.losses.positive? ? "敗" : "") %><%= "先発" if line.started.positive? %></td>
                  <td><%= innings_label(line.outs) %></td><td><%= line.batters_faced %></td><td><%= line.pitches %></td>
                  <td><%= line.hits %></td><td><%= line.home_runs %></td><td><%= line.strikeouts %></td><td><%= line.walks %></td>
                  <td><%= line.runs %></td><td><%= line.earned_runs %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
