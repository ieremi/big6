<%
  title = "#{@player.name}（#{@player.university.short_name}）"
  content_for :title, "#{title} - Big6"
  content_for :description, [ @player.university.name, ("#{@player.enter_year}年入学" if @player.enter_year), @player.role, @player.position ].compact.join(" ")
  content_for :image_url, player_og_image_url(@player)
%>

<h1>
  <span class="team-chip" style="background: <%= @player.university.color %>"><%= @player.university.initial %></span>
  <%= @player.name %>
</h1>
<% if @player.name_kana.present? %>
  <p class="muted"><%= @player.name_kana %></p>
<% end %>

<dl class="scoreboard-meta">
  <div>
    <dt>大学</dt>
    <dd><%= link_to @player.university.name, university_path(@player.university.slug) %></dd>
  </div>
  <% if @player.enter_year %>
    <div>
      <dt>入学年</dt>
      <dd>
        <%= link_to "#{@player.enter_year}年", players_path(university_ids: [ @player.university_id ], start_year: @player.enter_year, end_year: @player.enter_year) %>
      </dd>
    </div>
  <% end %>
  <% if @player.role.present? %>
    <div><dt>役割</dt><dd><%= player_filter_link(@player.role, "role_name") %></dd></div>
  <% end %>
  <% if @player.position.present? %>
    <div><dt>位置</dt><dd><%= player_filter_link(@player.position, "position") %></dd></div>
  <% end %>
  <% if hands_label(@player).present? %>
    <div><dt>投打</dt><dd><%= hands_label(@player) %></dd></div>
  <% end %>
  <% if @player.high_school.present? %>
    <div><dt>出身高校</dt><dd><%= player_filter_link(@player.high_school, "high_school") %></dd></div>
  <% end %>
  <% if @player.faculty.present? %>
    <div><dt>学部</dt><dd><%= player_filter_link(@player.faculty, "faculty") %></dd></div>
  <% end %>
  <% if enrollment_label(@player.enrollment_status) %>
    <div><dt>在籍</dt><dd><%= enrollment_label(@player.enrollment_status) %></dd></div>
  <% end %>
</dl>

<p class="muted">
  <%= link_to "Scorebookで成績を見る →", "https://big6scorebook.jp/member/#{@player.scorebook_id}", target: "_blank", rel: "noopener noreferrer" %>
</p>

<%= render "players/stats", stats: @stats %>

<%= render "players/games", log: @game_log %>

<p><%= link_to "← 選手一覧へ", players_path %></p>
