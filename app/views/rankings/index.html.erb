<%
  kind_title = @kind == "batting" ? "打者ランキング" : "投手ランキング"
  period_title = ranking_period_title
  content_for :title, "#{kind_title}（#{period_title}） - Big6"
  content_for :description, "東京六大学野球の#{kind_title}（#{period_title}、#{ranking_target_label(@kind, @minimum)}）"
%>

<h1><%= kind_title %></h1>

<div class="period-toolbar ranking-kinds">
  <% RankingsHelper::KIND_LABELS.each do |kind, label| %>
    <%= link_to label, rankings_kind_path(kind), class: [ "period-btn", ("active" if @kind == kind) ] %>
  <% end %>
</div>

<%= form_with url: ranking_path(@kind), method: :get, data: { controller: "search-filter", action: "change->search-filter#submit" } do %>
  <fieldset>
    <legend>期間</legend>
    <%= select_tag :season,
          options_for_select(
            (@complete_since ? [ [ "#{@complete_since.title}以降（全試合のデータあり）", "complete" ] ] : []) +
              [ [ "通算", "" ] ] + @seasons.map { |season| [ season.title, "#{season.year}-#{season.term}" ] },
            { season: @season && "#{@season.year}-#{@season.term}", complete: "complete", career: "" }.fetch(@period)
          ),
          "aria-label": "期間" %>
  </fieldset>

  <fieldset>
    <legend>大学</legend>
    <div class="period-toolbar">
      <button type="button" class="period-btn" data-action="search-filter#checkAllUniversities">すべて</button>
      <button type="button" class="period-btn" data-action="search-filter#clearUniversities">クリア</button>
    </div>
    <div class="checkbox-group">
      <% @universities.each do |u| %>
        <label class="checkbox-label">
          <%= check_box_tag "university_ids[]", u.id, @selected_university_ids.include?(u.id), data: { search_filter_target: "universityCheckbox" } %>
          <span class="team-chip" style="background: <%= u.color %>"><%= u.initial %></span>
          <%= u.short_name %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend>在籍</legend>
    <div class="period-toolbar">
      <%= tag.button "現役のみ", type: "button",
            class: [ "period-btn", ("active" if @active_only) ],
            data: { search_filter_target: "activeOnlyButton", action: "search-filter#toggleActiveOnly" } %>
      <%= hidden_field_tag :active_only, (@active_only ? "1" : ""), data: { search_filter_target: "activeOnlyInput" } %>
    </div>
  </fieldset>

  <fieldset>
    <legend>最低<%= ranking_unit(@kind) %>数</legend>
    <div class="period-toolbar">
      <%# Always the minimum in force, so that the arrows step from it (40 to 41). The default it is shown beside is sent too: a minimum still equal to it is "not asked for", and follows the period. %>
      <%= number_field_tag :minimum, @minimum, min: 0, max: PlayerRanking::MAX_MINIMUM, step: 1, "aria-label": "最低#{ranking_unit(@kind)}数" %>
      <%= hidden_field_tag :default_minimum, @default_minimum, id: "default_minimum" %>
      <%= ranking_unit(@kind) %>以上
      <% if @minimum == @default_minimum %>
        <span class="muted">（既定）</span>
      <% else %>
        <%= link_to "既定（#{@default_minimum}#{ranking_unit(@kind)}）に戻す", ranking_path(@kind, rankings_filter_params.except(*RankingsHelper::MINIMUM_PARAMS)), class: "period-btn" %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend>表示する順位</legend>
    <div class="period-toolbar">
      <%# Blank (or all) shows everyone; the top place is shared by all tied for it. %>
      上位 <%= number_field_tag :top, @top, min: 1, step: 1, placeholder: "すべて", "aria-label": "上位何位まで表示するか" %> 位まで
      <% if @top %>
        <%= link_to "すべて表示", ranking_path(@kind, rankings_filter_params.merge("top" => "all")), class: "period-btn" %>
      <% else %>
        <span class="muted">（すべて表示）</span>
      <% end %>
      <% unless @top == PlayerRanking::DEFAULT_TOP %>
        <%= link_to "上位#{PlayerRanking::DEFAULT_TOP}位に戻す", ranking_path(@kind, rankings_filter_params.except("top")), class: "period-btn" %>
      <% end %>
    </div>
  </fieldset>

  <% if @custom_sort %>
    <%= hidden_field_tag :sort, @sort %>
    <%= hidden_field_tag :direction, @direction %>
  <% end %>

  <noscript><%= submit_tag "表示" %></noscript>
<% end %>

<p class="muted">
  <%= @period == :season ? "シーズン" : ranking_period_title %>で<%= ranking_target_label(@kind, @minimum) %>が対象です（最低<%= ranking_unit(@kind) %>数は上の欄で変えられます）。<% if @minimum.zero? %>最低数がないため、<%= ranking_unit(@kind) %>の少ない選手が上位に並びます（見出しの「<%= ranking_unit(@kind) %>」で並べ替えられます）。<% end %>
  Scorebookに試合ごとのデータがある試合だけの集計で、優勝決定戦は含みません。
  <% if @missing_seasons.any? %>
    Scorebook には、試合ごとのデータがないシーズンが<%= @missing_seasons.size %>あります。<% if @period == :career %>通算では、その期間にいた選手の成績が実際より少なくなります（名前の横に「一部データなし」）。<% end %><% if @complete_since %>全試合のデータがそろっているのは<%= @complete_since.title %>以降です。<% end %>
  <% end %>
  <% if @kind == "batting" %>OPS ＝ 出塁率 ＋ 長打率（出塁率は犠飛を含めない簡易式です）。<% end %>
  見出しをクリックすると並べ替えられ、順位もその列の順につけ直されます（同じ値は同順位）。
</p>

<% if @missing_seasons.any? %>
  <details class="missing-seasons">
    <summary class="muted">データのないシーズン（<%= @missing_seasons.size %>）</summary>
    <p class="muted"><%= season_ranges(@missing_seasons).join("、") %></p>
  </details>
<% end %>

<p class="muted">
  <% if @top && @total_count < @ranked_count %>
    <%= number_with_delimiter(@ranked_count) %>人中、上位<%= @top %>位まで（<%= number_with_delimiter(@total_count) %>人、同順位を含む）
  <% else %>
    <%= number_with_delimiter(@total_count) %>人
  <% end %>
  <% if @last_page > 1 %>（<%= @page %> / <%= @last_page %> ページ）<% end %>
</p>

<% if @entries.any? %>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <% RankingsHelper::COLUMNS.fetch(@kind).each do |key, label| %>
            <%= ranking_column_header(key, label) %>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <% totals = entry.totals %>
          <tr>
            <td><%= entry.rank %></td>
            <td>
              <%= link_to entry.player.name, player_path(entry.player) %>
              <% if @period == :career && (missing = ranking_missing_seasons(entry.player)).any? %>
                <span class="season-tag" title="データなし：<%= missing.join("、") %>">一部データなし</span>
              <% end %>
            </td>
            <td>
              <span class="team-chip" style="background: <%= entry.player.university.color %>"><%= entry.player.university.initial %></span>
              <%= entry.player.university.short_name %>
            </td>
            <% if @kind == "batting" %>
              <td><%= ops_label(totals.ops) %></td>
              <td><%= batting_average_label(totals.average) %></td>
              <td><%= batting_average_label(totals.on_base_percentage) %></td>
              <td><%= batting_average_label(totals.slugging_percentage) %></td>
              <td><%= totals.games %></td><td><%= totals.pa %></td><td><%= totals.ab %></td><td><%= totals.hits %></td><td><%= totals.home_runs %></td>
            <% else %>
              <td><%= era_label(totals.era) %></td>
              <td><%= totals.games %></td><td><%= innings_label(totals.outs) %></td><td><%= totals.wins %></td><td><%= totals.losses %></td>
              <td><%= totals.hits %></td><td><%= totals.strikeouts %></td><td><%= totals.walks %></td><td><%= totals.earned_runs %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @last_page > 1 %>
    <nav class="pagination" aria-label="ページ送り">
      <% if @page > 1 %>
        <%= link_to "← 前へ", rankings_page_path(@page - 1), rel: "prev" %>
      <% end %>
      <span class="muted"><%= @page %> / <%= @last_page %></span>
      <% if @page < @last_page %>
        <%= link_to "次へ →", rankings_page_path(@page + 1), rel: "next" %>
      <% end %>
    </nav>
  <% end %>
<% else %>
  <p>条件に合う選手はいません。</p>
<% end %>
