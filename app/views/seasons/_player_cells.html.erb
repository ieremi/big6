<%# The rank, player and university cells of a 個人成績 row (SeasonPlayerStats::Row): no rank (－) for one short of the
    league's minimum, sorting last; the university sorts in the league's order. %>
<%= sort_cell row.rank || "－", row.rank %>
<td><%= link_to row.player.name, player_path(row.player) %></td>
<%= sort_cell safe_join([ tag.span(row.player.university.initial, class: "team-chip", style: "background: #{row.player.university.color}"), " ", row.player.university.short_name ]),
      row.player.university.position %>
