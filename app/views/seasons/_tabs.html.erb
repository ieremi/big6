<%# The season's pages as tabs, under its heading: 試合日程 (seasons#show), 順位・優勝のゆくえ (#standings), 観衆 (#attendance),
    チーム成績・記録・強さ (#records) and 個人成績 (#players). Each a page of its own, so each is worked out only when opened and has its own URL.
    Locals: season, current (:games, :standings, :attendance, :records or :players). %>
<% paths = {
     games: season_path(season.year, season.term),
     standings: standings_season_path(season.year, season.term),
     attendance: attendance_season_path(season.year, season.term),
     records: records_season_path(season.year, season.term),
     players: players_season_path(season.year, season.term)
   }
   tabs = SeasonsHelper::SEASON_TAB_LABELS.to_h { |key, label| [ key, [ label, paths.fetch(key) ] ] } %>
<nav class="season-tabs" aria-label="<%= season.title %>のページ">
  <% tabs.each do |key, (label, path)| %>
    <%= link_to label, path, class: [ "season-tab", ("active" if key == current) ], aria: { current: ("page" if key == current) } %>
  <% end %>
</nav>
