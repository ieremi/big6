<%# 優勝のゆくえ (TitleRace): who wins the season for every way the cards still open can end, as a grid —
    the earlier cards' results down the left, the later ones' along the top (each from the side of the university named
    first), and the champion in each cell, in its colours and by its initial (K, W, ...); two or more are a playoff (優勝決定戦). Under it, each
    university's chance with every game still to play an even chance. Only once the counting is small enough; a card
    that never changes the champion is left out.

    As it stood at the end of a week (TitleRaceWeeks), picked with a button for each week: the buttons are links inside
    the turbo frame, so one loads that week's race (and the buttons, the week picked marked) into the frame, down to
    the last week, when the season is over and the champion named. %>
<% race, weeks, point = local_assigns[:race], local_assigns[:weeks], local_assigns[:point] %>
<% if race&.applicable? %>
  <section class="title-race">
    <h2 class="card-heading">優勝のゆくえ</h2>

    <%= turbo_frame_tag "title-race", data: { turbo_action: "advance" } do %>
    <% if point && weeks.points.size > 1 %>
      <% season = race.season %>
      <nav class="period-toolbar title-race-weeks" aria-label="週">
        <% weeks.points.each do |each_point| %>
          <%= link_to "第#{each_point.week}週#{"（途中）" if each_point.in_progress}", standings_season_path(season.year, season.term, week: each_point.week),
                class: [ "period-btn", ("active" if each_point == point) ], aria: { current: ("true" if each_point == point) } %>
        <% end %>
      </nav>
      <p class="muted title-race-as-of"><%= point.label %>の優勝のゆくえです。</p>
    <% end %>

    <% if (settled = race.settled) && race.over? %>
      <p>
        <% if settled.size == 1 %>
          <strong><%= settled.first.short_name %>が優勝しました。</strong>
        <% else %>
          <strong><%= settled.map(&:short_name).join("・") %>が勝ち点と勝率で並び、優勝決定戦になりました。</strong>
          <% if (winner = race.playoff_winner) %><strong>決定戦で<%= winner.short_name %>が優勝しました。</strong><% end %>
        <% end %>
      </p>
    <% elsif settled %>
      <p>
        <% if settled.size == 1 %>
          <strong><%= settled.first.short_name %>の優勝が決まりました。</strong>残りの試合の結果にかかわらず、ほかの大学は届きません。
        <% else %>
          <strong><%= settled.map(&:short_name).join("・") %>の優勝決定戦になります。</strong>残りの試合の結果にかかわらず、勝ち点と勝率で並びます。
        <% end %>
      </p>
    <% elsif race.too_many_cards? %>
      <p class="muted">優勝にかかわるカードがまだ多いため、表は<%= TitleRace::MAX_CARDS %>カード以下になってから出します。</p>
    <% else %>
      <% rows, columns = race.row_cards, race.column_cards %>
      <% row_combos, column_combos = TitleRace.combinations(rows), TitleRace.combinations(columns) %>
      <% label = ->(result) { result.join("-") } %>
      <p class="muted">
        残りのカードの結果（カード名の左の大学から見た勝敗）ごとの優勝校です。大学名が2つ以上のマスは優勝決定戦です。
        結果を変えても優勝校が変わらないカードは省いています。
      </p>
      <div class="table-scroll">
        <table class="title-race-table">
          <thead>
            <%# Each card along the top has two rows: its name over the results it spans, then its results. The cards down the left are named in the last row, over their columns. A faint line (title-race-edge) parts the left from the results. %>
            <% left = [ rows.size, 1 ].max %>
            <% columns.each_with_index do |card, k| %>
              <% span = columns.drop(k + 1).map { |c| c.results.size }.inject(1, :*) %>
              <% repeat = columns.first(k).map { |c| c.results.size }.inject(1, :*) %>
              <tr>
                <%= tag.th colspan: (left if left > 1), class: "title-race-edge" %>
                <% repeat.times do %>
                  <%= tag.th card.label, class: "title-race-card", colspan: card.results.size * span %>
                <% end %>
              </tr>
              <tr>
                <% if k == columns.size - 1 && rows.any? %>
                  <% rows.each_with_index do |row_card, j| %><%= tag.th row_card.label, class: [ "title-race-card", ("title-race-edge" if j == rows.size - 1) ] %><% end %>
                <% else %>
                  <%= tag.th colspan: (left if left > 1), class: "title-race-edge" %>
                <% end %>
                <% repeat.times do %>
                  <% card.results.each do |result| %><%= tag.th label.(result), colspan: (span if span > 1) %><% end %>
                <% end %>
              </tr>
            <% end %>
          </thead>
          <tbody>
            <% row_combos.each_with_index do |row_results, i| %>
              <tr>
                <% if rows.empty? %>
                  <th>優勝</th>
                <% end %>
                <% rows.each_with_index do |row_card, j| %>
                  <% block = rows.drop(j + 1).map { |c| c.results.size }.inject(1, :*) %>
                  <% if (i % block).zero? %>
                    <%= tag.th label.(row_results[j]), rowspan: (block if block > 1), scope: "row" %>
                  <% end %>
                <% end %>
                <% column_combos.each do |column_results| %>
                  <% champions = race.champions_for(row_results + column_results) %>
                  <% names = champions.map(&:initial).join %>
                  <% if champions.size == 1 %>
                    <%= tag.td names, class: "title-race-cell", style: "background: #{champions.first.color}", title: "#{champions.first.short_name}の優勝" %>
                  <% else %>
                    <%= tag.td names, class: "title-race-cell title-race-playoff", title: "#{champions.map(&:short_name).join("・")}の優勝決定戦" %>
                  <% end %>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if race.chances.any? && race.settled.nil? %>
      <p class="muted">
        優勝の可能性（残りの試合をすべて五分五分とした場合）：<%= race.chances.map { |team, chance| "#{team.short_name} #{number_to_percentage(chance * 100, precision: 1)}" }.join("、") %>
      </p>
    <% end %>
    <% end %>
  </section>
<% end %>
