<%# Each university's chance of the title once each game had ended (TitleRaceTimeline#chances), as a line chart: the
    games along the bottom in the order played (each week's first named), the chance up the side, a line for each
    university that had a chance at some point. Pointing at the chart (or moving along it with the arrow keys once it
    has focus) shows the game and every university's chance there (chance-chart); a table under it has the same
    figures. The lines are in the universities' own colours (University#color), as in the grid below, each with a
    faint halo under it on the dark surface, where the darker ones would sink (see .chance-chart in the stylesheet);
    the end of each line still above 0 is labelled. %>
<% chances = timeline.chances %>
<% if chances.size > 1 %>
  <%
    # The order of the legend: 明大's purple and 慶大's navy, the closest pair, apart.
    order = %w[waseda keio hosei tokyo meiji rikkio]
    universities = chances.flat_map { |_, by_university| by_university.keys }.uniq.sort_by { |university| order.index(university.slug) || order.size }
    percent = ->(chance) { "#{number_with_precision(chance.to_f * 100, precision: 1, strip_insignificant_zeros: true)}%" }

    chart_w = 640
    chart_h = 240
    pad_l = 40
    pad_r = 96
    pad_t = 12
    pad_b = 28
    plot_w = chart_w - pad_l - pad_r
    plot_h = chart_h - pad_t - pad_b
    last = chances.size - 1
    x_for = ->(index) { (pad_l + index.to_f / last * plot_w).round(1) }
    y_for = ->(chance) { (pad_t + plot_h - chance.to_f * plot_h).round(1) }
    week_starts = chances.each_index.select { |i| i.zero? || chances[i - 1].first.week != chances[i].first.week }
    # Each week's first game has a tick; its name only when far enough from the last name to fit (a week of one game
    # would put two on top of each other).
    week_names = week_starts.each_with_object([]) { |i, named| named << i if named.empty? || x_for.(i) - x_for.(named.last) >= 44 }

    # The end of each line still above 0 has a dot, and a label; universities whose ends are too close to be read
    # apart share one ("明大・早大 50%", a playoff's even split; "明大 52%・早大 48%" when they differ).
    ends = chances.last.last.select { |_, chance| chance.positive? }.sort_by { |_, chance| -chance }
    end_groups = ends.slice_when { |(_, above), (_, below)| above - below >= 0.08 }.to_a
    end_label = lambda do |group|
      if group.map(&:last).uniq.size == 1
        "#{group.map { |university, _| university.short_name }.join("・")} #{percent.(group.first.last)}"
      else
        group.map { |university, chance| "#{university.short_name} #{percent.(chance)}" }.join("・")
      end
    end

    data = {
      universities: universities.map { |university| { slug: university.slug, name: university.short_name, color: university.color } },
      points: chances.each_with_index.map do |(point, by_university), index|
        { label: "#{point.label}のあと", x: x_for.(index), values: universities.to_h { |university| [ university.slug, by_university.fetch(university, 0) ] } }
      end
    }
  %>
  <figure class="chance-chart" data-controller="chance-chart" data-chance-chart-data-value="<%= data.to_json %>"
          data-chance-chart-width-value="<%= chart_w %>" data-chance-chart-top-value="<%= pad_t %>" data-chance-chart-height-value="<%= plot_h %>">
    <figcaption class="muted">試合ごとの優勝の可能性（その時点で残りの試合をすべて五分五分とした場合）</figcaption>
    <div class="chance-chart-plot">
      <svg viewBox="0 0 <%= chart_w %> <%= chart_h %>" preserveAspectRatio="xMidYMid meet" role="img" tabindex="0"
           aria-label="試合ごとの優勝の可能性の推移。矢印キーで試合を移れます。数値は下の表にもあります。"
           data-chance-chart-target="svg"
           data-action="pointermove->chance-chart#point pointerleave->chance-chart#hide focus->chance-chart#focus blur->chance-chart#hide keydown->chance-chart#key">
        <% [ 0, 0.25, 0.5, 0.75, 1 ].each do |chance| %>
          <line x1="<%= pad_l %>" y1="<%= y_for.(chance) %>" x2="<%= pad_l + plot_w %>" y2="<%= y_for.(chance) %>" class="chance-gridline" />
          <text x="<%= pad_l - 6 %>" y="<%= y_for.(chance) + 4 %>" text-anchor="end" class="chance-axis-label"><%= (chance * 100).round %>%</text>
        <% end %>
        <% week_starts.each do |index| %>
          <line x1="<%= x_for.(index) %>" y1="<%= pad_t + plot_h %>" x2="<%= x_for.(index) %>" y2="<%= pad_t + plot_h + 4 %>" class="chance-gridline" />
        <% end %>
        <% week_names.each do |index| %>
          <text x="<%= x_for.(index) %>" y="<%= chart_h - 8 %>" text-anchor="<%= index.zero? ? "start" : "middle" %>" class="chance-axis-label">第<%= chances[index].first.week %>週</text>
        <% end %>

        <% universities.each do |university| %>
          <% line = chances.each_with_index.map { |(_, by_university), index| "#{x_for.(index)},#{y_for.(by_university.fetch(university, 0))}" }.join(" ") %>
          <polyline points="<%= line %>" class="chance-halo" />
          <polyline points="<%= line %>" class="chance-line" style="stroke: <%= university.color %>" />
        <% end %>
        <% ends.each do |university, chance| %>
          <circle cx="<%= x_for.(last) %>" cy="<%= y_for.(chance) %>" r="4" class="chance-end" style="fill: <%= university.color %>" />
        <% end %>
        <% end_groups.each do |group| %>
          <text x="<%= x_for.(last) + 9 %>" y="<%= y_for.(group.first.last) + 4 %>" class="chance-end-label"><%= end_label.(group) %></text>
        <% end %>

        <line class="chance-crosshair" y1="<%= pad_t %>" y2="<%= pad_t + plot_h %>" data-chance-chart-target="crosshair" visibility="hidden" />
        <% universities.each do |university| %>
          <circle r="4" class="chance-end" style="fill: <%= university.color %>" data-chance-chart-target="dot" data-slug="<%= university.slug %>" visibility="hidden" />
        <% end %>
      </svg>
      <div class="chance-tooltip" data-chance-chart-target="tooltip" hidden></div>
    </div>

    <ul class="chance-legend">
      <% universities.each do |university| %>
        <li><span class="chance-key" style="background: <%= university.color %>"></span><%= university.short_name %></li>
      <% end %>
    </ul>
    <% if universities.size < University.count %>
      <p class="muted chance-note">この間に優勝の可能性がなかった大学は省いています。</p>
    <% end %>

    <details class="chance-table">
      <summary>数値を表で見る</summary>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>試合</th>
              <% universities.each do |university| %><th><%= university.short_name %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% chances.each do |point, by_university| %>
              <tr>
                <td><%= point.label %></td>
                <% universities.each do |university| %><td class="num"><%= percent.(by_university.fetch(university, 0)) %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  </figure>
<% end %>
