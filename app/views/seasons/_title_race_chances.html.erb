<%# Each university's chance of the title once each game had ended (TitleRaceTimeline#chances), as a line chart
    (seasons/_university_line_chart): a line for each university that had a chance at some point. %>
<% chances = timeline.chances %>
<% if chances.size > 1 %>
  <%= render "seasons/university_line_chart",
        rows: chances.map { |point, by_university| { label: point.label, tooltip: "#{point.label}のあと", week: point.week, values: by_university } },
        caption: "試合ごとの優勝の可能性（その時点で残りの試合をすべて五分五分とした場合）",
        aria_label: "試合ごとの優勝の可能性の推移",
        note: ("この間に優勝の可能性がなかった大学は省いています。" if chances.flat_map { |_, by_university| by_university.keys }.uniq.size < University.count) %>
<% end %>
