<%# 大学で絞る: checkboxes of the season's universities, sent to url as university_ids[] as soon as one changes
    (search-filter). Locals: url, universities, selected_ids, and shortcuts (optional, true by default): false on a page
    whose sortable tables already take the universities' initials as keys (H, K, M, R, W). %>
<% shortcuts = local_assigns.fetch(:shortcuts, true) %>
<%= form_with url: url, method: :get, data: { controller: "search-filter", action: "change->search-filter#submit" } do %>
  <fieldset>
    <legend>大学で絞る</legend>
    <div class="period-toolbar">
      <button type="button" class="period-btn" data-action="search-filter#clearUniversities">クリア</button>
    </div>
    <div class="checkbox-group">
      <% universities.each do |u| %>
        <%= tag.label class: "checkbox-label", data: ({ shortcut: u.initial, shortcut_label: "#{u.short_name}を切替" } if shortcuts) do %>
          <%= check_box_tag "university_ids[]", u.id, selected_ids.include?(u.id), id: "university_ids_#{u.id}", data: { search_filter_target: "universityCheckbox" } %>
          <span class="team-chip" style="background: <%= u.color %>"><%= u.initial %></span>
          <%= u.short_name %>
          <% if shortcuts %><kbd><%= u.initial %></kbd><% end %>
        <% end %>
      <% end %>
    </div>
  </fieldset>
  <noscript><%= submit_tag "絞り込む" %></noscript>
<% end %>
