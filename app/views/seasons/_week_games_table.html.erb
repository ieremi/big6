<table>
  <thead>
    <tr>
      <th>日付</th>
      <th>回戦</th>
      <th>対戦</th>
      <th>観衆</th>
    </tr>
  </thead>

  <tbody>
    <% games.each do |game| %>
      <tr>
        <td><%= game.played_on %></td>
        <td><%= game.game_number %>回戦</td>
        <td>
          <%= link_to game_path(game) do %>
            <%= game.team0.short_name %>
            <%= score_span(game.team0_score, game.team1_score, played_on: game.played_on, status: game.game_status) %>
            <%= game.team1.short_name %>
          <% end %>
        </td>
        <td><%= game.attendance.present? ? number_with_delimiter(game.attendance) : "-" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
