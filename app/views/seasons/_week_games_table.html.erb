<div class="table-scroll">
  <table class="week-games-table">
    <thead>
      <tr>
        <th class="col-date">日付</th>
        <th class="col-round">回戦</th>
        <th class="col-matchup">対戦</th>
        <th class="col-attendance">観衆</th>
      </tr>
    </thead>

    <tbody>
      <% games.each do |game| %>
        <tr>
          <td><%= game.played_on %></td>
          <td><%= round_label(game) %></td>
          <td><%= game_matchup_link(game) %></td>
          <td><%= game.attendance.present? ? number_with_delimiter(game.attendance) : "-" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
