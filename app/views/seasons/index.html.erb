<h1>シーズン一覧</h1>

<% @seasons.group_by { |season| (season.year / 10) * 10 }.each_with_index do |(decade, seasons), index| %>
  <%= tag.details class: "decade", open: index.zero? do %>
    <%= tag.summary "#{decade}〜#{decade + 9}年" %>
    <ul class="list">
      <% seasons.each do |season| %>
        <li>
          <% if @games_counts[season.id].to_i > 0 %>
            <%= link_to season.title, season_path(season) %>
            <span class="muted">
              (<%= @games_counts[season.id] %>試合<% if @attendance_totals[season.id] %>・観衆<%= number_with_delimiter(@attendance_totals[season.id]) %>人<% end %>)
            </span>
            ・<%= link_to "順位表", standings_season_path(season) %>
          <% else %>
            <span class="muted"><%= season.title %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
