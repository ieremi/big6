<%
  content_for :title, "シーズン一覧 - Big6"
  content_for :description, "東京六大学野球のシーズン一覧（1925年〜）"
  content_for :image_url, seasons_index_og_image_url
%>

<h1>シーズン一覧</h1>

<%= form_with url: seasons_path, method: :get, data: { controller: "search-filter", action: "change->search-filter#submit" } do %>
  <fieldset>
    <legend>タグで絞り込み</legend>
    <div class="checkbox-group">
      <% SeasonTags::LABELS.each do |label| %>
        <label class="checkbox-label">
          <%= check_box_tag "tags[]", label, @selected_tags.include?(label) %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </fieldset>
<% end %>

<div data-controller="decade-fold">
  <div class="period-toolbar">
    <button type="button" class="period-btn" data-action="decade-fold#openAll" data-shortcut="u" data-shortcut-label="すべて開く">すべて開く <kbd>u</kbd></button>
    <button type="button" class="period-btn" data-action="decade-fold#closeAll" data-shortcut="f" data-shortcut-label="すべて閉じる">すべて閉じる <kbd>f</kbd></button>
  </div>

  <% @seasons.group_by { |season| (season.year / 10) * 10 }.each_with_index do |(decade, seasons), index| %>
    <%= tag.details class: "decade", open: (@selected_tags.any? || index.zero?), data: { decade_fold_target: "decade" } do %>
      <%= tag.summary "#{decade}〜#{decade + 9}年" %>
      <ul class="list season-list">
        <% seasons.each do |season| %>
          <li>
            <% if @games_counts[season.id].to_i > 0 %>
              <%= link_to season.title, season_path(season.year, season.term) %>
              <span class="muted">
                (<%= @games_counts[season.id] %>試合<% if @attendance_totals[season.id] %>・総観衆<%= number_with_delimiter(@attendance_totals[season.id]) %>人<% end %>)
              </span>
              ・<%= link_to "順位表", standings_season_path(season.year, season.term) %>
              <% @season_tags[season.id]&.each do |t| %>
                <span class="season-tag"><%= t.label %></span>
              <% end %>
            <% else %>
              <span class="muted"><%= season.title %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
