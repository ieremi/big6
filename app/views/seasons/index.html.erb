<h1>シーズン一覧</h1>

<ul>
  <% @seasons.each do |season| %>
    <li>
      <% if @games_counts[season.id].to_i > 0 %>
        <%= link_to season.title, season_path(season) %>
        (<%= @games_counts[season.id] %>試合)
      <% else %>
        <%= season.title %>
      <% end %>
    </li>
  <% end %>
</ul>
