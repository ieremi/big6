<%
  content_for :title, "#{@season.title} - Big6"
  content_for :description, "#{@season.title}の試合結果一覧"
  content_for :image_url, season_og_image_url(@season.year, @season.term)
%>

<%= link_to "← シーズン一覧", seasons_path, class: "back-link" %>

<h1><%= @season.title %></h1>

<% if @tags.any? %>
  <p>
    <% @tags.each do |t| %>
      <span class="season-tag"><%= t.label %></span>
    <% end %>
  </p>
<% end %>

<% if @games.any? %>
  <p><%= link_to "順位表を見る", standings_season_path(@season.year, @season.term) %></p>
<% end %>

<% if @games.any? %>
  <% @weeks.each do |week| %>
    <h2 class="week-heading">第<%= week.number %>週</h2>

    <% week.series.each do |s| %>
      <h3 class="card-heading"><%= s.team0.short_name %> vs <%= s.team1.short_name %></h3>

      <table>
        <thead>
          <tr>
            <th>日付</th>
            <th>回戦</th>
            <th>対戦</th>
          </tr>
        </thead>

        <tbody>
          <% s.games.each do |game| %>
            <tr>
              <td><%= game.played_on %></td>
              <td><%= game.game_number %>回戦</td>
              <td>
                <%= link_to game_path(game) do %>
                  <%= game.team0.short_name %>
                  <%= score_span(game.team0_score, game.team1_score, played_on: game.played_on) %>
                  <%= game.team1.short_name %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
<% else %>
  <p class="muted">試合データがありません。</p>
<% end %>
