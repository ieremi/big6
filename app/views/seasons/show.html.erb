<%= link_to "← シーズン一覧", seasons_path, class: "back-link" %>

<h1><%= @season.title %></h1>

<% if @games.any? %>
  <p><%= link_to "順位表を見る", standings_season_path(@season) %></p>
<% end %>

<% if @games.any? %>
  <table>
    <thead>
      <tr>
        <th>日付</th>
        <th>回戦</th>
        <th>対戦</th>
      </tr>
    </thead>

    <tbody>
      <% @games.each do |game| %>
        <tr>
          <td><%= game.played_on %></td>
          <td><%= game.game_number %>回戦</td>
          <td>
            <%= link_to game_path(game) do %>
              <%= game.team0.short_name %>
              <%= score_span(game.team0_score, game.team1_score) %>
              <%= game.team1.short_name %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted">試合データがありません。</p>
<% end %>
