<%
  content_for :title, site_title("#{@season.title} 試合結果・日程")
  content_for :description, @heading.summary.to_s
  content_for :image_url, season_og_image_url(@season.year, @season.term)
%>

<%= render "seasons/heading", season: @season, heading: @heading, current: :games %>

<% if @games.any? %>
  <%# The calendar has the games shown: those of the chosen universities, or all of them. %>
  <% ics_params = { format: :ics, university_ids: @selected_university_ids.presence } %>
  <p>
    <%= link_to "カレンダーに追加 (.ics)", season_path(@season.year, @season.term, **ics_params) %>
    ・
    <%= link_to "Googleカレンダーに登録", google_calendar_subscribe_url(season_url(@season.year, @season.term, **ics_params)), target: "_blank", rel: "noopener noreferrer" %>
  </p>
  <%= render "shared/ics_preview", url: season_path(@season.year, @season.term, **ics_params) %>
<% end %>

<% if @conventions %>
  <%= render "conventions", result: @conventions %>
<% end %>

<% if @games.any? %>
  <%= render "seasons/university_filter", url: season_path(@season.year, @season.term), universities: @universities, selected_ids: @selected_university_ids %>

  <% if @selected_university_ids.any? %>
    <p class="muted">
      <%= @universities.select { |u| @selected_university_ids.include?(u.id) }.map(&:short_name).join("・") %>の試合のみ：<%= @shown_game_count %>試合（全<%= @played_game_count %>試合）
    </p>
  <% end %>

  <div data-controller="week-sort">
    <div class="period-toolbar">
      週のなかのならび：
      <button type="button" class="period-btn active" data-week-sort-target="button" data-mode="card" data-action="week-sort#setMode" data-shortcut="c" data-shortcut-label="週内をカードごとに表示">カードごと <kbd>c</kbd></button>
      <button type="button" class="period-btn" data-week-sort-target="button" data-mode="date" data-action="week-sort#setMode" data-shortcut="d" data-shortcut-label="週内を日付ごとに表示">日付ごと <kbd>d</kbd></button>
    </div>

    <% @weeks.each do |week| %>
      <h2 class="week-heading">第<%= week.number %>週</h2>

      <div data-week-sort-target="view" data-mode="card">
        <% week.series.each do |s| %>
          <h3 class="card-heading"><%= s.team0.short_name %> vs <%= s.team1.short_name %></h3>
          <%= render "week_games_table", games: s.games %>
        <% end %>
      </div>

      <div data-week-sort-target="view" data-mode="date" hidden>
        <% week.games.group_by(&:played_on).each do |date, games| %>
          <h3 class="card-heading"><%= date %></h3>
          <%= render "week_games_table", games: games.sort_by { |g| g.game_order || Float::INFINITY } %>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="muted">試合データがありません。</p>
<% end %>
