<%
  content_for :title, "#{@season.title} 順位表 - Big6"
  content_for :description, "#{@season.title}の順位表"
  content_for :image_url, season_og_image_url(@season.year, @season.term, label: "Standings")
%>

<h1><%= @season.title %> 順位表</h1>

<% if @standings.rows.all? { |row| row.games.zero? } %>
  <p class="muted">試合データがありません。</p>
<% else %>
  <p class="muted">
    <%= link_to "試合一覧を見る", season_path(@season.year, @season.term) %>
  </p>

  <div class="table-zoom" data-controller="cell-toggle table-zoom" data-action="keydown.esc@window->table-zoom#closeOnEscape">
    <div class="table-zoom-backdrop" data-table-zoom-target="backdrop" data-action="click->table-zoom#close"></div>

    <div class="table-scroll" data-table-zoom-target="panel">
      <div class="table-zoom-bar">
        <button type="button" class="table-zoom-btn" data-table-zoom-target="button" data-action="table-zoom#toggle">⤢ 拡大表示</button>
      </div>

      <div class="period-toolbar">
        <span class="muted">セル表示:</span>
        <button type="button" class="period-btn" data-mode="results" data-cell-toggle-target="button" data-action="cell-toggle#setMode">対戦成績</button>
        <button type="button" class="period-btn" data-mode="attendance" data-cell-toggle-target="button" data-action="cell-toggle#setMode">観衆数</button>
      </div>

      <table class="standings-table">
        <thead>
          <tr>
            <th class="col-rank">順位</th>
            <th class="col-team"></th>
            <% @standings.rows.each do |col_row| %>
              <th>
                <span class="team-chip" style="background: <%= col_row.university.color %>">
                  <%= col_row.university.initial %>
                </span>
              </th>
            <% end %>
            <th data-cell-toggle-target="resultsColumn">試合</th>
            <th data-cell-toggle-target="resultsColumn">勝利</th>
            <th data-cell-toggle-target="resultsColumn">敗戦</th>
            <th data-cell-toggle-target="resultsColumn">引分</th>
            <th data-cell-toggle-target="resultsColumn">勝ち点</th>
            <th data-cell-toggle-target="resultsColumn">勝率</th>
            <th data-cell-toggle-target="attendanceColumn">総観衆</th>
            <th data-cell-toggle-target="attendanceColumn">平均観衆</th>
          </tr>
        </thead>

        <tbody>
          <% @standings.rows.each_with_index do |row, index| %>
            <tr>
              <td class="col-rank"><span class="rank-badge"><%= index + 1 %></span></td>
              <td class="col-team">
                <span class="team-chip" style="background: <%= row.university.color %>">
                  <%= row.university.initial %>
                </span>
              </td>
              <% @standings.rows.each do |col_row| %>
                <td class="result-cell">
                  <% if col_row.university == row.university %>
                    <span class="dash">---</span>
                  <% else %>
                    <% results_text = @standings.results_between(row.university, col_row.university).join %>
                    <% attendance_text = @standings.attendances_between(row.university, col_row.university)
                         .map { |a| a ? number_with_delimiter(a) : "-" }.join("/") %>
                    <%= link_to results_text,
                          matchup_season_path(row.university.slug, col_row.university.slug, @season.year, @season.term),
                          data: { cell_toggle_target: "cell", results: results_text, attendance: attendance_text } %>
                  <% end %>
                </td>
              <% end %>
              <td data-cell-toggle-target="resultsColumn"><%= row.games %></td>
              <td data-cell-toggle-target="resultsColumn"><%= row.wins %></td>
              <td data-cell-toggle-target="resultsColumn"><%= row.losses %></td>
              <td data-cell-toggle-target="resultsColumn"><%= row.draws %></td>
              <td data-cell-toggle-target="resultsColumn"><%= row.points %></td>
              <td data-cell-toggle-target="resultsColumn"><%= number_with_precision(row.percentage, precision: 3).sub(/\A0/, "") %></td>
              <td data-cell-toggle-target="attendanceColumn"><%= number_with_delimiter(row.attendance_total) %></td>
              <td data-cell-toggle-target="attendanceColumn"><%= row.average_attendance ? number_with_delimiter(row.average_attendance) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
