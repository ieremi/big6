<%
  content_for :title, site_title("#{@season.title} 順位表・優勝のゆくえ")
  content_for :description, standings_meta_description(@season, @standings)
  content_for :image_url, season_og_image_url(@season.year, @season.term, label: "Standings")
%>

<%= render "seasons/heading", season: @season, heading: @heading, current: :standings %>

<% if @season.source_standings %>
  <%= render "seasons/printed_standings", season: @season %>
<% elsif @season.from_printed_sources? %>
  <%# Only one club's games, from its history, and no 勝敗表 there: a table worked out from them would be wrong. %>
  <p class="muted">
    この季の試合は、このサイトには<%= link_to "一部しかありません", season_path(@season.year, @season.term) %>。
    出典に勝敗表がないため、順位表は載せていません。
  </p>
<% elsif @standings.rows.all? { |row| row.games.zero? } %>
  <p class="muted">試合データがありません。</p>
<% else %>
  <% if @season.points_season? %>
    <%# Standings ranks these seasons by points (Season#points_season?): say so, as the 勝ち点 here isn't the usual one. %>
    <p class="muted">
      この季は<%= @season.year == 2020 && @season.term == "spring" ? "1カード1試合の総当たり" : "1カード2試合" %>で、勝ち点をかけた3回戦制ではありませんでした。
      連盟の方式どおり、勝ち1点・引分0.5点の合計を勝ち点とし、次に勝率で順位を決めています。
      勝ち点も勝率も同じ2校は、直接対決の勝敗で上下をつけています。
    </p>
  <% end %>

  <div class="table-zoom" data-controller="table-zoom" data-action="keydown.esc@window->table-zoom#closeOnEscape">
    <div class="table-zoom-backdrop" data-table-zoom-target="backdrop" data-action="click->table-zoom#close"></div>

    <div class="table-scroll" data-table-zoom-target="panel">
      <div class="table-zoom-bar">
        <button type="button" class="table-zoom-btn" data-table-zoom-target="button" data-action="table-zoom#toggle">⤢ 拡大表示</button>
      </div>

      <%# Sortable in the browser by the figures on the right (SeasonsHelper::STANDINGS_COLUMNS), which show only in 拡大表示; the rank keeps the standings' own order, and 「並べ替えをリセット」 brings it back. The rank and team columns are too narrow for a sort button. %>
      <table class="standings-table" data-controller="sortable-table">
        <thead>
          <tr>
            <th class="col-rank">順位</th>
            <th class="col-team"></th>
            <% @standings.rows.each do |col_row| %>
              <th>
                <span class="team-chip" style="background: <%= col_row.university.color %>">
                  <%= col_row.university.initial %>
                </span>
              </th>
            <% end %>
            <%= standings_stat_headers %>
          </tr>
        </thead>

        <tbody>
          <% @standings.rows.each do |row| %>
            <tr>
              <%# Filled (白抜き) once the place is decided, as the league's own table marks it; a plain number while it can change. %>
              <% decided = @place_race.applicable? ? (@place_race.over? || @place_race.decided_place(row.university) == row.rank) : @season_over %>
              <td class="col-rank"><%= tag.span row.rank, class: [ "rank-badge", ("open" unless decided) ], title: ("確定" if decided) %></td>
              <td class="col-team">
                <span class="team-chip" style="background: <%= row.university.color %>">
                  <%= row.university.initial %>
                </span>
              </td>
              <% @standings.rows.each do |col_row| %>
                <td class="result-cell">
                  <% if col_row.university == row.university %>
                    <span class="dash">---</span>
                  <% else %>
                    <% results_text = @standings.results_between(row.university, col_row.university).join %>
                    <%= link_to results_text, matchup_season_path(row.university.slug, col_row.university.slug, @season.year, @season.term) %>
                  <% end %>
                </td>
              <% end %>
              <td data-stat-column><%= row.games %></td>
              <td data-stat-column><%= row.wins %></td>
              <td data-stat-column><%= row.losses %></td>
              <td data-stat-column><%= row.draws %></td>
              <td data-stat-column><%= row.points %></td>
              <td data-stat-column data-sort-value="<%= row.percentage %>"><%= number_with_precision(row.percentage, precision: 3).sub(/\A0/, "") %></td>
              <td data-stat-column><%= row.runs_scored %></td>
              <td data-stat-column><%= row.runs_allowed %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "seasons/place_race", race: @place_race, standings: @standings %>
  <%= render "seasons/title_race", race: @title_race, timeline: @title_race_timeline, point: @title_race_point %>
<% end %>
