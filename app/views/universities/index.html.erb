<%
  content_for :title, "大学一覧 - Big6"
  content_for :description, "東京六大学野球連盟の加盟校一覧"
  content_for :image_url, universities_og_image_url
%>

<h1>大学一覧</h1>

<ul class="list">
  <% @universities.each do |university| %>
    <li>
      <strong><%= university.name %></strong>
      <span class="muted">（<%= university.short_name %>）</span>
    </li>
  <% end %>
</ul>
